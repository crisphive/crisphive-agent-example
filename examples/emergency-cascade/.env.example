# Sandbox API key (chsk_test_...) — get one at docs.crisphive.com ("Get demo key")
CRISPHIVE_API_KEY=chsk_test_xxx
# API origin. The default is production; chsk_test_ keys only ever touch sandbox data there.
CRISPHIVE_API_URL=https://api.crisphive.com
# Only needed for `npm run agent` (the Claude-over-MCP flow)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional model override for the agent
ANTHROPIC_MODEL=claude-opus-5
