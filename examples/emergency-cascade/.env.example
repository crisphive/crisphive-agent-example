# Sandbox API key (chsk_test_...) — get one at docs.crisphive.com ("Get demo key")
CRISPHIVE_API_KEY=chsk_test_xxx
# API origin. The default is production; chsk_test_ keys only ever touch sandbox data there.
CRISPHIVE_API_URL=https://api.crisphive.com
# Only needed for `npm run agent` (the Claude-over-MCP flow)
ANTHROPIC_API_KEY=sk-ant-xxx
# REQUIRED for the agent — no default, you pick what you pay for.
# claude-haiku-4-5 (cheapest) · claude-sonnet-5 (good default) · claude-opus-5 (expensive)
ANTHROPIC_MODEL=claude-sonnet-5
# REQUIRED — per-turn output token cap. 4000 is plenty for tool-driven flows;
# every turn re-sends the whole conversation + tool results, so keep it tight.
ANTHROPIC_MAX_TOKENS=4000
