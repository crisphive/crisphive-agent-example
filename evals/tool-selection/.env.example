# Sandbox API key (chsk_test_...) — the eval REFUSES live keys (questions mutate data)
CRISPHIVE_API_KEY=chsk_test_xxx
# API origin. The default is production; chsk_test_ keys only ever touch sandbox data there.
CRISPHIVE_API_URL=https://api.crisphive.com
ANTHROPIC_API_KEY=sk-ant-xxx
# REQUIRED — no default, you pick what you pay for. A full 10-question run is
# ~15+ multi-turn conversations where every turn re-sends the whole context.
# claude-haiku-4-5 (cheapest) · claude-sonnet-5 (good default) · claude-opus-5 (expensive)
ANTHROPIC_MODEL=claude-sonnet-5
# REQUIRED — per-turn output token cap. Tool selection needs no essays.
ANTHROPIC_MAX_TOKENS=4000
# Optional — pause_turn continuations per question before giving up (default 6)
EVAL_MAX_TURNS=6
